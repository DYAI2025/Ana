# /etc/ana-brain/env — mode 0600, owner root:ana-brain. Never commit real values.
BRAIN_VAULT_DIR=
BRAIN_STATE_DIR=
OLLAMA_URL=
QDRANT_URL=
QDRANT_API_KEY=
BRAIN_PUBLIC_URL=
BRAIN_DASHBOARD_TOKEN_SHA256=
PORT=
HOST=
# Google Drive (ANA Evidence Root), read-only, as the Brain service account. Drive is off while ANA_DRIVE_ROOT_ID
# is empty; once it is set the service-account key file must exist (default /etc/ana-brain/drive-sa.json).
ANA_DRIVE_ROOT_ID=
ANA_DRIVE_SA_KEY_FILE=
ANA_DRIVE_TRANSCRIPTS_ID=
