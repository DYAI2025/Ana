# /etc/ana-brain/env — mode 0600, owner root:ana-brain. Never commit real values.
BRAIN_VAULT_DIR=
BRAIN_STATE_DIR=
OLLAMA_URL=
QDRANT_URL=
QDRANT_API_KEY=
BRAIN_PUBLIC_URL=
