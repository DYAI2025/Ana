# Server-side Jira connection for the Board / Backlog work projection (ANA-5).
# Copy to .env.local (git-ignored) and fill in; never commit real values, never prefix with NEXT_PUBLIC_.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=integration-account@example.com
JIRA_API_TOKEN=
# optional, milliseconds per Jira request
JIRA_TIMEOUT_MS=10000

# Server-side Instagram worker connection for the Social cockpit (ANA-38). Localhost only; never NEXT_PUBLIC_.
# The key is the worker's INTERNAL_READ_KEY (macOS keychain item ana-instagram-oauth/INTERNAL_READ_KEY).
SOCIAL_IG_WORKER_URL=https://login.example.invalid
SOCIAL_IG_INTERNAL_READ_KEY=
# optional: worker timeout ms (default 45000), posts per snapshot 1..50 (default 50)
SOCIAL_IG_TIMEOUT_MS=45000
SOCIAL_IG_MAX_POSTS=50

# Server-side Brain projection API (ANA-35, docs/brain/CONTRACT.md §5). The dashboard server reads
# GET {BRAIN_API_URL}/projection with this bearer token; the browser never sees either. Never NEXT_PUBLIC_.
BRAIN_API_URL=
BRAIN_API_TOKEN=
# optional, milliseconds for the projection read
BRAIN_TIMEOUT_MS=10000
# ANA World "Was läuft" → Brain: daily aggregated digest via MCP as an agent key (agent:lumen); loopback URL only
ANA_BRAIN_MCP_URL=
ANA_BRAIN_WRITE_KEY=
