# Server-side Jira connection for the Board / Backlog work projection (ANA-5).
# Copy to .env.local (git-ignored) and fill in; never commit real values, never prefix with NEXT_PUBLIC_.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=integration-account@example.com
JIRA_API_TOKEN=
# optional, milliseconds per Jira request
JIRA_TIMEOUT_MS=10000
