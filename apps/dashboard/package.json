{
  "name": "@ana/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "ANA LUMEN clickable localhost prototype (ANA-4). All content is local prototype data.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
