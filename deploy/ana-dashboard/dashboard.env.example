# /opt/ana-dashboard/dashboard.env — root:root 600. Example only: real values never enter Git.
ANA_ACCESS_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<64-hex AUD tag of the ana.dyai.cloud Access application>
ANA_ALLOWED_EMAILS=<exactly the invited addresses, comma-separated>
SOCIAL_IG_WORKER_URL=https://login.dyai.cloud
SOCIAL_IG_INTERNAL_READ_KEY=<the worker's INTERNAL_READ_KEY>
# Jira stays unset until the least-privilege integration account of ANA-33 exists (views show "not configured").
