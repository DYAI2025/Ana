# /etc/dyai/credentials/ana-dashboard/dashboard_env — root:root 600. Example only: real values never enter Git.
# ANA_ACCESS_MODE, ANA_CONTAINER, HOSTNAME and PORT are pinned in dyai-ana-dashboard.service; values here cannot override them.
CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=<64-hex AUD tag of the ana.dyai.cloud Access application>
ANA_ALLOWED_EMAILS=<exactly the three invited addresses of the Access policy, comma-separated>
SOCIAL_IG_WORKER_URL=https://login.dyai.cloud
SOCIAL_IG_INTERNAL_READ_KEY=<the worker's INTERNAL_READ_KEY>
# Jira: unset = the views show "not configured". Which account the server uses is an owner decision (ANA-33).
# JIRA_BASE_URL=https://dyai2026.atlassian.net
# JIRA_EMAIL=<integration account>
# JIRA_API_TOKEN=<its API token>
# ANA Brain projection (ANA-35, deploy/ana-brain): the Brain runs on this host on loopback. The token is issued with
# `brain.sh issue-dashboard-token` on the host; unset = the Brain page shows "not configured".
# BRAIN_API_URL=http://127.0.0.1:8790
# BRAIN_API_TOKEN=<the dashboard token of the Brain>
# ANA World (ANA-48): Ana's current region for the 3D world, region level only, never committed. Unset = "place not set".
# WORLD_ANA_PLACE=<label>;<lat>;<lon>
